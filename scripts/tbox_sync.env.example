# TBOX 本机 ↔ 远端同步配置
#   cp scripts/tbox_sync.env.example scripts/tbox_sync.env
#   编辑 scripts/tbox_sync.env（勿提交；已在 .gitignore）
#
# 文档：docs/TBOX_SYNC_LOCAL_REMOTE.md

# --- Git（代码同步）---
TBOX_SYNC_GIT_REMOTE=myrepo
TBOX_SYNC_GIT_BRANCH=tbox-deploy
# 推送前是否自动 git push（需工作区已 commit）
TBOX_SYNC_GIT_PUSH=1

# --- 远端 SSH（数据包 rsync）---
# Windows 需开启 OpenSSH Server 或使用 WSL 路径
TBOX_SYNC_REMOTE=user@192.168.1.100
# 远端备份目录（会 rsync 整个 tbox-sync-* 目录进去）
TBOX_SYNC_REMOTE_BACKUP_DIR=/c/ragflow/backups
# Linux 远端示例：/opt/ragflow/backups

# --- 本机路径（可选覆盖）---
# TBOX_SYNC_REPO_ROOT=/home/vboxuser/ragflow
# TBOX_SYNC_LOCAL_BACKUP_ROOT=/home/vboxuser/ragflow/backups

# --- 推送后是否在远端自动 restore（慎用：会覆盖远端 KB 数据）---
TBOX_SYNC_REMOTE_RESTORE=0
# 远端仓库根（REMOTE_RESTORE=1 时用于 git pull + restore）
# TBOX_SYNC_REMOTE_REPO=C:/ragflow/ragflow
