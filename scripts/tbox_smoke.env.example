# TBOX 自动化冒烟环境变量（复制为 scripts/tbox_smoke.env 后填写）
#
#   cp scripts/tbox_smoke.env.example scripts/tbox_smoke.env
#   bash scripts/tbox_setup_smoke_env.sh
#   # 编辑 scripts/tbox_smoke.env（勿提交；已在 .gitignore）
#
# 各 smoke 脚本会在启动时自动 source scripts/tbox_smoke.env（若存在）。
# 文档：docs/TBOX_SMOKE_ENV.md · 发版矩阵：bash scripts/tbox_pre_release.sh --help

# --- API / Console ---
TBOX_SMOKE_BASE_URL=http://127.0.0.1:9380
TBOX_CONSOLE_URL=http://127.0.0.1:5180
# TBOX_SMOKE_RUNNER=docker
# TBOX_SMOKE_CONTAINER=docker-ragflow-cpu-1

# --- Admin 登录（默认 admin@ragflow.io / admin）---
# TBOX_LOGIN_EMAIL=admin@ragflow.io
# TBOX_LOGIN_PASSWORD=admin
# TBOX_SMOKE_EMAIL=admin@ragflow.io
# TBOX_SMOKE_PASSWORD=admin

# --- 双账号权限回归（VM §3 D；tbox_permissions_smoke.sh）---
# 普通用户须已在系统中创建且非 owner/admin 角色。
# 与 TBOX_REQUIRE_DUAL_ACCOUNT=1 联用时须同时填写 EMAIL 与 PASSWORD。
# TBOX_SMOKE_NORMAL_EMAIL=coolge101@163.com
# TBOX_SMOKE_NORMAL_PASSWORD=your-normal-user-password

# --- 发版门禁（export 或写入本文件；见 docs/TBOX_SMOKE_ENV.md）---
# TBOX_PRE_RELEASE_VM=1          # pre_release 第 2 步跑 VM 7 步（非 suite）
# TBOX_SKIP_HOST_CHECK=1         # 跳过 web-tbox + scripts unit
# TBOX_REQUIRE_DUAL_ACCOUNT=1    # 须完整 TBOX_SMOKE_NORMAL_*（见上）
# TBOX_SKIP_CONSOLE_BUNDLE_SMOKE=1
# TBOX_PHASE16_17_CONFIRM=1      # 等同 archive --confirm（手测归档 §5）

# --- G3 DeepSeek live chat（可选）---
# TBOX_SMOKE_DEEPSEEK_API_KEY=sk-...
